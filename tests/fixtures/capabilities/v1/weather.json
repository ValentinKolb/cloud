    {
      "localId": "city.search",
      "title": "Search German cities",
      "description": "Find bounded German city candidates and coordinates for forecasts or saved locations.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "German city name to search for."
          },
          "limit": {
            "default": 10,
            "description": "Maximum number of city candidates to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxItems": 25,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "country": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "name",
            "lat",
            "lon"
          ],
          "additionalProperties": false
        }
      },
      "schemaHash": "c75107e5ea456618e73914a1c67a845b8b7d91941be02e1e43f0bb2c32982314",
      "openWorld": true
    },
    {
      "localId": "forecast.current",
      "title": "Get current weather",
      "description": "Get current weather for one owned saved location or explicit coordinates. Temperatures use degrees Celsius, wind uses km/h, precipitation uses mm, pressure uses hPa, and visibility uses metres.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "saved",
                    "description": "Use a saved location owned by the current user."
                  },
                  "locationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "Stable UUID of the saved weather location."
                  }
                },
                "required": [
                  "kind",
                  "locationId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "coordinates",
                    "description": "Use explicit latitude and longitude."
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90,
                    "description": "Latitude in decimal degrees from -90 to 90."
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Longitude in decimal degrees from -180 to 180."
                  }
                },
                "required": [
                  "kind",
                  "lat",
                  "lon"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Saved location or explicit coordinates used for the forecast."
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number",
            "minimum": -100,
            "maximum": 70,
            "description": "Air temperature in degrees Celsius."
          },
          "icon": {
            "type": "string",
            "enum": [
              "clear-day",
              "clear-night",
              "partly-cloudy-day",
              "partly-cloudy-night",
              "cloudy",
              "fog",
              "wind",
              "rain",
              "sleet",
              "snow",
              "hail",
              "thunderstorm"
            ]
          },
          "cloudCover": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Cloud cover percentage from 0 to 100."
          },
          "windSpeed": {
            "type": "number",
            "minimum": 0,
            "maximum": 500,
            "description": "Wind speed in kilometres per hour."
          },
          "windGust": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ],
            "description": "Wind gust speed in kilometres per hour."
          },
          "windDirection": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              {
                "type": "null"
              }
            ],
            "description": "Wind direction in degrees."
          },
          "humidity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "Relative humidity percentage from 0 to 100."
          },
          "precipitation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "description": "Precipitation in millimetres during the last hour."
          },
          "pressure": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean sea-level pressure in hectopascals."
          },
          "visibility": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ],
            "description": "Visibility in metres."
          },
          "dewPoint": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -100,
                "maximum": 70
              },
              {
                "type": "null"
              }
            ],
            "description": "Dew point in degrees Celsius."
          },
          "sunshine": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 60
              },
              {
                "type": "null"
              }
            ],
            "description": "Sunshine duration in minutes during the last hour."
          },
          "stationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "temperature",
          "icon",
          "cloudCover",
          "windSpeed",
          "windGust",
          "windDirection",
          "humidity",
          "precipitation",
          "pressure",
          "visibility",
          "dewPoint",
          "sunshine",
          "stationName",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "schemaHash": "98869b6101be7ca4c470cf8cffaf609af6a7eaceee134e407782ca642cebfb83",
      "openWorld": true
    },
