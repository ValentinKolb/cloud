{
  "name": "@k2b/ui",
  "version": "0.1.0",
  "description": "Opinionated SolidJS components for @k2b/ssr applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValentinKolb/cloud.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/ValentinKolb/cloud",
  "bugs": "https://github.com/ValentinKolb/cloud/issues",
  "type": "module",
  "sideEffects": [
    "./dist/*.css",
    "./src/fonts/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./fonts/plex.css": "./dist/plex.css",
    "./icons/tabler.css": "./dist/tabler.css"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "MIGRATION.md",
    "migration-inventory.json",
    "!src/ai/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:migration": "bun run scripts/check-migration-inventory.ts",
    "test": "bun run build && bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@k2b/stdlib": "0.17.0",
    "@tabler/icons-webfont": "^3.44.0"
  },
  "peerDependencies": {
    "@k2b/ssr": "^0.12.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@k2b/ssr": "0.12.0",
    "@types/bun": "1.3.9",
    "bun-plugin-tailwind": "^0.1.2",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-or-later"
}
