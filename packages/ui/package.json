{
  "name": "@k2b/ui",
  "version": "0.1.0",
  "description": "Opinionated SolidJS components for @k2b/ssr applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValentinKolb/cloud.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/ValentinKolb/cloud",
  "bugs": "https://github.com/ValentinKolb/cloud/issues",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts/plex.css": "./dist/plex.css",
    "./icons/tabler.css": "./dist/tabler.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "MIGRATION.md",
    "migration-inventory.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.typecheck.ts",
    "!src/styles/css-contract-test-helpers.ts"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:declarations": "bun run scripts/check-declarations.ts",
    "check:migration": "bun run scripts/check-migration-inventory.ts",
    "check:packed-consumer": "\"$npm_execpath\" run build && \"$npm_execpath\" run scripts/check-packed-consumer.ts",
    "fixture:build": "bun run build && NODE_ENV=production bun run fixture/scripts/build.ts",
    "fixture:dev": "NODE_ENV=development bun --preload ./fixture/src/preload.ts ./fixture/src/server.ts",
    "fixture:typecheck": "tsc -p fixture/tsconfig.json --noEmit --pretty false",
    "test": "\"$npm_execpath\" run build && \"$npm_execpath\" test src scripts && \"$npm_execpath\" run test:dom && \"$npm_execpath\" run scripts/check-packed-consumer.ts",
    "test:dom": "\"$npm_execpath\" test --conditions=browser --preload ./test/solid-dom-preload.ts ./test",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && bun run check:declarations && bun run typecheck:dom",
    "typecheck:dom": "tsc -p test/tsconfig.json --noEmit --pretty false",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@k2b/stdlib": "0.17.1",
    "@tabler/icons-webfont": "^3.44.0",
    "marked": "^17.0.1"
  },
  "peerDependencies": {
    "@k2b/ssr": "^0.12.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@k2b/ssr": "0.12.0",
    "@types/bun": "1.3.9",
    "babel-preset-solid": "^1.9.12",
    "bun-plugin-tailwind": "^0.1.2",
    "happy-dom": "20.11.1",
    "hono": "^4.11.1",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-or-later"
}
