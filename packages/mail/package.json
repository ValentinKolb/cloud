{
  "name": "@valentinkolb/cloud-app-mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./capability-contracts": "./src/capability-contracts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false 2>&1 | grep -v node_modules | (! grep -q 'error TS')",
    "test": "bun --cwd=../.. test packages/mail/src",
    "test:integration": "MAIL_INTEGRATION_TESTS=1 bun --cwd=../.. test --parallel=1 packages/mail/src",
    "test:connector": "bun --cwd=../.. test packages/mail/src/service/connectors/connector-conformance.integration.test.ts",
    "test:performance:100k": "MAIL_PERFORMANCE_TESTS=1 MAIL_PERFORMANCE_MESSAGE_COUNT=100000 bun --cwd=../.. test packages/mail/src/service/performance.integration.test.ts",
    "browser-smoke": "bun --env-file=../../.env run scripts/browser-smoke.ts"
  },
  "dependencies": {
    "@valentinkolb/cloud": "workspace:*",
    "@k2b/ui": "workspace:*",
    "@k2b/ssr": "0.12.0",
    "@k2b/stdlib": "0.18.0",
    "@k2b/sync": "5.9.1",
    "@zone-eu/mailsplit": "5.4.14",
    "fast-xml-parser": "^5.9.3",
    "hono": "^4.11.1",
    "hono-openapi": "^1.1.2",
    "html-to-text": "^10.0.0",
    "imapflow": "^1.4.6",
    "juice": "^12.1.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^8.0.10",
    "postcss": "^8.5.19",
    "postcss-selector-parser": "^7.1.0",
    "sanitize-html": "^2.17.4",
    "solid-js": "^1.9.10",
    "yaml": "^2.9.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.1",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-or-later"
}
